// Test nahole jodi + logical operators + break/continue

shonkha a = 75;
doshomik nts = 5.5;
lehkho(nts);
jodi (a > 90) {
    lehkho("Excellent");
}
nahole jodi (a > 80) {
    lehkho("Very Good");
}
nahole jodi (a > 70 && a < 80) {
    lehkho("Good");
} 
nahole {
    lehkho("Needs Improvement");
}

shonkha i = 0;
lehkho("sakib is the KING");
jokhon (i < 10) {
    i = i + 1;

    jodi (i == 2 || i == 4) {
        cholo;
    }

    jodi (i > 8 && i < 10) {
        thamvai;
    }

    lehkho(i);
}
